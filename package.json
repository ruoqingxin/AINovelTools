{
  "name": "ainoveltools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.9.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @ainoveltools/desktop tauri dev",
    "build": "pnpm --filter @ainoveltools/desktop build",
    "check": "pnpm -r check && node tools/validate-ipc-contract.mjs && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "pnpm -r test && cargo test --workspace",
    "tauri": "pnpm --filter @ainoveltools/desktop tauri"
  }
}
